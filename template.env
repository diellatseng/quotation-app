# Supabase
REACT_APP_SUPABASE_URL=https://your-project.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-supabase-anon-key

# PDF export server
REACT_APP_PDF_SERVER_URL=http://localhost:3001

# EmailJS
REACT_APP_EMAILJS_PUBLIC_KEY=your-emailjs-public-key
REACT_APP_EMAILJS_SERVICE_ID=your-emailjs-service-id
REACT_APP_EMAILJS_TEMPLATE_ID=your-emailjs-template-id

# Company information shown on quotations
REACT_APP_COMPANY_NAME=Your Company Name
REACT_APP_COMPANY_ADDRESS=Your Company Address
REACT_APP_COMPANY_PHONE=Your Company Phone
REACT_APP_COMPANY_FAX=Your Company Fax
REACT_APP_COMPANY_EMAIL=info@example.com

# React app hosting path. Leave empty for root hosting.
PUBLIC_URL=

# Optional PDF/server port
PORT=3001

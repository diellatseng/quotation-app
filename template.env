# Copy to .env.local in the project root (Vite loads VITE_* at build time).
# cp template.env .env.local

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# PDF export server (Puppeteer — run server/ separately)
VITE_PDF_SERVER_URL=http://localhost:3001

# Company information shown on quotations
VITE_COMPANY_NAME=Your Company Name
VITE_COMPANY_ADDRESS=Your Company Address
VITE_COMPANY_PHONE=Your Company Phone
VITE_COMPANY_FAX=Your Company Fax
VITE_COMPANY_EMAIL=info@example.com

# PDF server port (server/index.js)
PORT=3001
